{
  "name": "gml-linux",
  "version": "0.1.2",
  "description": "Biblioth\u00e8que graphique pour lancer des jeux Windows sous Linux avec Wine",
  "desktopName": "org.gameemulinux.launcher",
  "main": "src/main.js",
  "author": "GML contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dev-Messy0/game-emu-linux.git"
  },
  "homepage": "https://github.com/Dev-Messy0/game-emu-linux",
  "bugs": {
    "url": "https://github.com/Dev-Messy0/game-emu-linux/issues"
  },
  "scripts": {
    "start": "electron .",
    "dist:deb": "electron-builder --linux deb --publish never"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "org.gameemulinux.launcher",
    "productName": "GML",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "icon": "assets/icon.png",
      "category": "Game",
      "syncDesktopName": true,
      "target": [
        "deb"
      ],
      "maintainer": "GML contributors",
      "synopsis": "Biblioth\u00e8que et lanceur de jeux Windows sous Linux",
      "description": "Organisez votre biblioth\u00e8que de jeux et lancez les ex\u00e9cutables Windows avec Wine."
    },
    "deb": {
      "depends": [
        "wine"
      ]
    }
  }
}
